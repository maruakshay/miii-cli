{
  "name": "miii-cli",
  "version": "1.0.0",
  "type": "module",
  "description": "The high-performance local AI coding agent for your terminal. Automate complex workflows with local LLMs.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maruakshay/miii-cli.git"
  },
  "homepage": "https://github.com/maruakshay/miii-cli#readme",
  "bugs": {
    "url": "https://github.com/maruakshay/miii-cli/issues"
  },
  "keywords": [
    "ai-coding-assistant",
    "local-llm",
    "ollama",
    "terminal-agent",
    "autonomous-coding",
    "cli-tool",
    "developer-experience",
    "open-source-ai",
    "local-ai",
    "software-engineering"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "miii": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "link": "npm run build && npm link",
    "test": "vitest run"
  },
  "dependencies": {
    "ink": "^5.2.0",
    "minimist": "^1.2.8",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.6"
  }
