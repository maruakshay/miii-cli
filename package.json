{
  "name": "miii-agent",
  "version": "3.10.0",
  "description": "Local AI coding agent for your terminal — an open-source, offline alternative to Claude Code, Cursor, and GitHub Copilot, powered by Ollama. Private by default, free forever.",
  "type": "module",
  "bin": {
    "miii": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "tsx src/cli.tsx",
    "eval": "tsx src/cli.tsx eval",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch src/cli.tsx",
    "build": "tsup && vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "postbuild": "node -e \"if(process.platform!=='win32')require('fs').chmodSync('dist/cli.js',0o755)\"",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maruakshay/miii-cli.git"
  },
  "homepage": "https://github.com/maruakshay/miii-cli#readme",
  "bugs": {
    "url": "https://github.com/maruakshay/miii-cli/issues"
  },
  "keywords": [
    "cli",
    "ai",
    "ai-agent",
    "coding-agent",
    "ai-coding-assistant",
    "ollama",
    "llm",
    "local-llm",
    "local-first",
    "offline",
    "privacy",
    "terminal",
    "tui",
    "ink",
    "agent",
    "pair-programming",
    "code-generation",
    "llama-cpp",
    "lm-studio",
    "copilot",
    "copilot-alternative",
    "cursor-alternative",
    "claude-code",
    "claude-code-alternative",
    "developer-tools",
    "qwen"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "cli-highlight": "^2.1.11",
    "execa": "^9.0.0",
    "ink": "^5.0.0",
    "marked": "^12.0.2",
    "marked-terminal": "^7.3.0",
    "ollama": "^0.5.0",
    "react": "^18.3.0",
    "string-width": "^7.2.0",
    "wrap-ansi": "^9.0.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.49.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  }
}
